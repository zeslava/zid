FROM 15.0-RELEASE

PARAM allow.sysvipc=true

RUN pkg install -y postgresql18-server

SERVICE postgresql --no-user --run-user=postgres : /usr/local/bin/postgres -D /var/db/postgres/data18 -c config_file=/usr/local/etc/postgresql/postgresql.conf -c hba_file=/usr/local/etc/postgresql/pg_hba.conf
LOG /var/log/postgresql/postgresql.log

RUN su -l postgres -c 'test -f /var/db/postgres/data18/PG_VERSION || initdb -D /var/db/postgres/data18'

COPY --chown=postgres:postgres dail/postgresql.conf /usr/local/etc/postgresql/postgresql.conf
COPY --chown=postgres:postgres dail/pg_hba.conf /usr/local/etc/postgresql/pg_hba.conf
