FROM 15.0-RELEASE

PARAM allow.sysvipc=true

RUN pkg install -y postgresql18-server

SERVICE postgresql --no-user : /usr/local/bin/postgres -D /var/db/postgres/data18 -c config_file=/usr/local/etc/postgresql/postgresql.conf -c hba_file=/usr/local/etc/postgresql/pg_hba.conf

RUN su -l postgres -c 'initdb -D /var/db/postgres/data18'

COPY --chown=postgres:postgres dail/postgresql.conf /usr/local/etc/postgresql/postgresql.conf
COPY --chown=postgres:postgres dail/pg_hba.conf /usr/local/etc/postgresql/pg_hba.conf
